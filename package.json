{
  "name": "agentflow",
  "version": "1.0.0",
  "description": "AI agent orchestration platform — pipeline-based task runner for Claude, Codex, and Gemini CLI agents with a visual dashboard and MCP server",
  "type": "module",
  "bin": {
    "agentflow": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "dist/",
    "dist-server/",
    "NOTICE"
  ],
  "scripts": {
    "clean:runtime": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist-server', { recursive: true, force: true });\"",
    "dev": "concurrently -n be,fe -c green,cyan \"tsx watch server/index.ts\" \"tsx scripts/wait-for-dev-api.ts && vite\"",
    "dev:fe": "vite",
    "dev:be": "tsx watch server/index.ts",
    "build": "npm run build:client && npm run build:runtime",
    "build:client": "vite build",
    "build:runtime": "npm run clean:runtime && tsc -p tsconfig.build.json",
    "start": "node bin/cli.js",
    "lint": "eslint . && npm run typecheck",
    "preview": "vite preview",
    "mcp": "tsx mcp/index.ts",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json"
  },
  "keywords": [
    "ai",
    "agent",
    "orchestration",
    "pipeline",
    "claude",
    "codex",
    "gemini",
    "mcp",
    "task-runner"
  ],
  "author": "Harun Yardimci <harun.yardimci@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/harun-yardimci/agentflow.git"
  },
  "homepage": "https://github.com/harun-yardimci/agentflow#readme",
  "bugs": {
    "url": "https://github.com/harun-yardimci/agentflow/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.0",
    "@dicebear/core": "^9.4.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
